---
/**
 * Product-focused visual composition representing HexaFox's actual work (FoxDesk & custom software).
 * Replaces founder imagery with a modern, non-human capability badge.
 */
import { withBase } from '@lib/url';
---

<a class="hero-product-badge" href={withBase('#product')}>
  <span class="hero-product-badge__status">
    <span class="hero-product-badge__dot" aria-hidden="true"></span>
    <span class="hero-product-badge__tag">FoxDesk AI</span>
  </span>
  <span class="hero-product-badge__text">
    AI assistants, custom web & enterprise solutions
    <span class="hero-product-badge__arrow" aria-hidden="true">→</span>
  </span>
</a>

<style>
  .hero-product-badge {
    display: inline-flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--space-3);
    margin-top: var(--space-3);
    padding: var(--space-2) var(--space-4);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-pill);
    background: rgb(23 19 42 / 0.65);
    backdrop-filter: blur(8px);
    text-decoration: none;
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    transition:
      border-color var(--dur-fast) ease,
      background-color var(--dur-fast) ease,
      color var(--dur-fast) ease;
  }

  .hero-product-badge:hover,
  .hero-product-badge:focus-visible {
    border-color: var(--color-violet);
    background: rgb(30 25 54 / 0.85);
    color: var(--color-text);
  }

  .hero-product-badge:focus-visible {
    outline: 2px solid var(--color-lavender);
    outline-offset: 2px;
  }

  .hero-product-badge__status {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    padding: 2px var(--space-2);
    border-radius: var(--radius-pill);
    background: rgb(139 92 246 / 0.15);
  }

  .hero-product-badge__dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--color-success);
    box-shadow: 0 0 8px var(--color-success);
  }

  .hero-product-badge__tag {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.05em;
    text-transform: uppercase;
    color: var(--color-lavender);
  }

  .hero-product-badge__text {
    display: inline-flex;
    align-items: center;
    gap: var(--space-2);
    white-space: normal;
  }

  .hero-product-badge__arrow {
    color: var(--color-violet-soft);
    transition: transform var(--dur-fast) ease;
  }

  .hero-product-badge:hover .hero-product-badge__arrow {
    transform: translateX(3px);
  }

  @media (prefers-reduced-motion: reduce) {
    .hero-product-badge,
    .hero-product-badge__arrow {
      transition: none;
      transform: none !important;
    }
  }
</style>
