---
import type { SolutionCardData } from '@data/solutions';

interface Props {
  card: SolutionCardData;
  index: number;
}

const { card, index } = Astro.props;
---

<li class="solution-card" data-reveal style={`--reveal-delay: ${index * 90}ms`}>
  <div class="solution-card__header">
    <div class="solution-card__icon-wrap" aria-hidden="true">
      {
        card.icon === 'brain-circuit' && (
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M12 5a3 3 0 1 0-5.997.125 4 4 0 0 0-2.526 5.77 4 4 0 0 0 .556 6.588A4 4 0 1 0 12 18Z" />
            <path d="M9 13a4.5 4.5 0 0 0 3-4" />
            <path d="M12 13h4" />
            <path d="M12 18h6a2 2 0 0 1 2 2v1" />
            <path d="M12 8h8" />
            <circle cx="16" cy="13" r="1" fill="currentColor" />
            <circle cx="20" cy="8" r="1" fill="currentColor" />
          </svg>
        )
      }
      {
        card.icon === 'code-2' && (
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="m18 16 4-4-4-4" />
            <path d="m6 8-4 4 4 4" />
            <path d="m14.5 4-5 16" />
          </svg>
        )
      }
      {
        card.icon === 'wrench' && (
          <svg viewBox="0 0 24 24" width="24" height="24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M14.7 6.3a1 1 0 0 0 0 1.4l1.6 1.6a1 1 0 0 0 1.4 0l3.77-3.77a6 6 0 0 1-7.94 7.94l-6.91 6.91a2.12 2.12 0 0 1-3-3l6.91-6.91a6 6 0 0 1 7.94-7.94l-3.76 3.76z" />
          </svg>
        )
      }
    </div>
    <h3 class="solution-card__title">{card.title}</h3>
    <p class="solution-card__description">{card.description}</p>
  </div>

  <div class="solution-card__footer">
    <span class="solution-card__capabilities-label">Capabilities</span>
    <ul class="solution-card__capabilities">
      {
        card.capabilities.map((cap) => (
          <li>
            <svg class="check-icon" viewBox="0 0 16 16" width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
              <path d="M13.25 4.75 6 12 2.75 8.75" />
            </svg>
            <span>{cap}</span>
          </li>
        ))
      }
    </ul>
  </div>
</li>

<style>
  .solution-card {
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: var(--space-5);
    padding: clamp(1.5rem, 1.25rem + 1vw, 2.25rem);
    border: 1px solid var(--color-line);
    border-radius: var(--radius-lg);
    background:
      radial-gradient(ellipse at 90% 0%, rgb(139 92 246 / 0.12), transparent 70%),
      var(--color-surface);
    transition:
      transform var(--dur-fast) ease,
      border-color var(--dur-fast) ease,
      box-shadow var(--dur-fast) ease;
  }

  .solution-card:hover {
    border-color: var(--color-line-strong);
    transform: translateY(-4px);
    box-shadow:
      0 16px 32px -12px rgb(14 11 26 / 0.8),
      0 0 0 1px rgb(139 92 246 / 0.25);
  }

  .solution-card__header {
    display: grid;
    gap: var(--space-3);
  }

  .solution-card__icon-wrap {
    display: inline-grid;
    place-items: center;
    width: 44px;
    height: 44px;
    border-radius: var(--radius-md);
    background: rgb(139 92 246 / 0.12);
    border: 1px solid rgb(139 92 246 / 0.25);
    color: var(--color-lavender);
    margin-bottom: var(--space-2);
  }

  .solution-card__title {
    font-size: 1.25rem;
    font-weight: 600;
    line-height: 1.25;
    letter-spacing: -0.015em;
    color: var(--color-text);
  }

  .solution-card__description {
    font-size: var(--text-sm);
    color: var(--color-text-muted);
    line-height: 1.6;
  }

  .solution-card__footer {
    display: grid;
    gap: var(--space-3);
    padding-top: var(--space-4);
    border-top: 1px solid var(--color-line);
  }

  .solution-card__capabilities-label {
    font-size: var(--text-xs);
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--color-violet-soft);
  }

  .solution-card__capabilities {
    display: grid;
    gap: var(--space-2);
    font-size: var(--text-sm);
    color: var(--color-text);
  }

  .solution-card__capabilities li {
    display: flex;
    align-items: center;
    gap: var(--space-2);
  }

  .check-icon {
    flex: none;
    color: var(--color-violet-soft);
  }

  @media (prefers-reduced-motion: reduce) {
    .solution-card {
      transition: none;
      transform: none !important;
    }
  }
</style>
